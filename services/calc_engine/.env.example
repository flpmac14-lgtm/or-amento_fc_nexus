EXTRACTOR_URL=http://localhost:8001

# Opcional: connection string do Postgres do Supabase (Project Settings ->
# Database -> Connection string, modo "Transaction pooler" recomendado).
# Sem essa variável, o motor usa a fixture local em app/materiais_fixture.py.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Opcional: só usado por scripts/importar_precos_erp.py (importação
# pontual de preços reais do ERP pra historico_compras). Login DEVE ser
# somente leitura — o script nunca escreve no ERP.
ERP_SQL_SERVER=<host,porta>
ERP_SQL_DATABASE=<database>
ERP_SQL_USER=<login-somente-leitura>
ERP_SQL_PASSWORD=<senha>
